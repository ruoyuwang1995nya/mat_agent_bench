; NPT equilibration parameters
integrator  = md
nsteps      = 1000000   ; 2 ns at dt=0.002
dt          = 0.002

; Output
nstxout-compressed = 5000
nstenergy          = 500
nstlog             = 500

; Neighbor list
nstlist     = 10
cutoff-scheme = Verlet
ns_type     = grid

; Electrostatics
coulombtype = PME
rcoulomb    = 1.0

; VdW
rvdw        = 1.0

; Temperature coupling
tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 298.15

; Pressure coupling
pcoupl      = Parrinello-Rahman
pcoupltype  = isotropic
tau_p       = 2.0
ref_p       = 1.0
compressibility = 4.5e-5

; Constraints
constraints          = h-bonds
constraint_algorithm = lincs

; PBC
pbc         = xyz

; Velocity generation
gen_vel     = yes
gen_temp    = 298.15
gen_seed    = -1
